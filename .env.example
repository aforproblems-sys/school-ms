# ==============================================================================
# EDUMANAGE PRO — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT:
# - Copy this file to '.env' or '.env.local' for local development.
# - DO NOT place real production secrets, API keys, or passwords inside Git.
# - Server-only secrets MUST NOT be prefixed with NEXT_PUBLIC_.
# - Variables marked [PUBLIC] are baked into client JS bundles during build time.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Server-Only Secrets)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@your-db-host.internal:5432/school_ms?schema=public&sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@your-db-host.internal:5432/school_ms?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION CONFIGURATION (Server-Only Secrets)
# ------------------------------------------------------------------------------
# Generate strong 64-character random strings for production secrets (e.g. `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-min-64-chars-long"
NEXTAUTH_SECRET="replace-with-a-secure-random-nextauth-secret-min-64-chars-long"
NEXTAUTH_URL="https://app.yourdomain.com"

# ------------------------------------------------------------------------------
# 3. PUBLIC APPLICATION SETTINGS [PUBLIC / CLIENT-SAFE]
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="EduManage Pro"
NEXT_PUBLIC_APP_URL="https://app.yourdomain.com"
NEXT_PUBLIC_BILLING_CURRENCY="USD"

# ------------------------------------------------------------------------------
# 4. STORAGE & FILE ISOLATION CONFIGURATION (Server-Only Secrets / Config)
# ------------------------------------------------------------------------------
# Options: "local" (or "mock") | "s3" | "supabase"
STORAGE_PROVIDER="local"
STORAGE_UPLOADS_DIR="/var/data/edumanage/uploads"

# Optional Cloud Storage Credentials (Required if STORAGE_PROVIDER="s3")
AWS_S3_BUCKET="edumanage-production-storage"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA_YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"

# ------------------------------------------------------------------------------
# 5. DATABASE BACKUP CONFIGURATION (Server-Only Config)
# ------------------------------------------------------------------------------
BACKUP_DIR="/var/backups/edumanage"
BACKUP_RETENTION_DAILY="7"
BACKUP_RETENTION_WEEKLY="4"
BACKUP_RETENTION_MONTHLY="12"
RECOVERY_TARGET_DB="school_ms_recovery"

# ------------------------------------------------------------------------------
# 6. EXTERNAL EMAIL COMMUNICATIONS (SMTP) (Server-Only Secrets)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="SG.YOUR_SENDGRID_API_KEY_HERE"
SMTP_FROM="EduManage Notifications <noreply@yourdomain.com>"

# ------------------------------------------------------------------------------
# 7. EXTERNAL WHATSAPP & SMS COMMUNICATIONS (Twilio) (Server-Only Secrets)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="AC_YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
TWILIO_SMS_NUMBER="+18005550199"

# ------------------------------------------------------------------------------
# 8. ERROR REPORTING & MONITORING (Optional Server-Only Secrets)
# ------------------------------------------------------------------------------
SENTRY_DSN=""
MONITORING_ENABLED="true"
MAINTENANCE_MODE="false"

